+void VulkanTextureCache::Dbz3CaptureTextureReadback(Texture& texture_base, VkBuffer scratch,
+                                                    VkDeviceSize scratch_offset,
+                                                    VkDeviceSize level_size, uint32_t row_bytes,
+                                                    uint32_t row_texels, uint32_t width,
+                                                    uint32_t height, VkFormat format,
+                                                    bool block_compressed) {
+  VulkanTexture& texture = static_cast<VulkanTexture&>(texture_base);
+  const TextureKey& key = texture.key();
+  if (!level_size || !dbz3_capture::WantsTextureReadback(level_size * 2)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  uint32_t header[9] = {0,
+                        uint32_t(key.base_page) << 12,
+                        uint32_t(key.format),
+                        width,
+                        height,
+                        uint32_t(format),
+                        row_bytes,
+                        uint32_t(key.tiled) | (uint32_t(key.endianness) << 8) |
+                            (uint32_t(key.mip_max_level) << 16) |
+                            (uint32_t(key.packed_mips) << 24),
+                        uint32_t(level_size)};
+  // Etapa 0: saida do shader de carga (ja com a barreira para leitura de transferencia).
+  dbz3_capture::TextureReadback r0;
+  r0.size = level_size;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, level_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, r0.buffer, r0.memory, &r0.memory_type)) {
+    return;
+  }
+  VkBufferCopy buffer_copy = {scratch_offset, 0, level_size};
+  command_buffer.CmdVkCopyBuffer(scratch, r0.buffer, 1, &buffer_copy);
+  std::memcpy(r0.header, header, sizeof(header));
+  dbz3_capture::NoteTextureReadback(r0);
+
+  // Etapa 1: o nivel 0 da imagem, lido com a mesma arrumacao (linhas de row_texels).
+  dbz3_capture::TextureReadback r1;
+  r1.size = level_size;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, level_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, r1.buffer, r1.memory, &r1.memory_type)) {
+    return;
+  }
+  const VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), range, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.bufferOffset = 0;
+  region.bufferRowLength = row_texels;
+  region.bufferImageHeight = 0;
+  region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.imageSubresource.mipLevel = 0;
+  region.imageSubresource.baseArrayLayer = 0;
+  region.imageSubresource.layerCount = 1;
+  region.imageExtent = {width, height, 1};
+  if (block_compressed) {
+    // Blocos 4x4: a imagem tem de ser copiada inteira em blocos.
+    region.imageExtent.width = width;
+    region.imageExtent.height = height;
+  }
+  command_buffer.CmdVkCopyImageToBuffer(texture.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                        r1.buffer, region);
+  command_processor_.PushImageMemoryBarrier(
+      texture.image(), range, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  std::memcpy(r1.header, header, sizeof(header));
+  r1.header[0] = 1;
+  dbz3_capture::NoteTextureReadback(r1);
+}
