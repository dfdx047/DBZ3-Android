+void TextureCache::Texture::Dbz3ForceReload(
+    const std::unique_lock<std::recursive_mutex>& global_lock) {
+  SharedMemory& shared_memory = texture_cache().shared_memory();
+  if (base_watch_handle_) {
+    shared_memory.UnwatchMemoryRange(base_watch_handle_);
+    base_watch_handle_ = nullptr;
+  }
+  if (mips_watch_handle_) {
+    shared_memory.UnwatchMemoryRange(mips_watch_handle_);
+    mips_watch_handle_ = nullptr;
+  }
+  uint32_t mask = 0;
+  if (GetGuestBaseSize()) {
+    base_outdated_ = true;
+    mask |= kOutdatedBitBase;
+  }
+  if (GetGuestMipsSize()) {
+    mips_outdated_ = true;
+    mask |= kOutdatedBitMips;
+  }
+  outdated_mask_.fetch_or(mask, std::memory_order_release);
+}
+
+uint32_t TextureCache::Dbz3ReloadAllForCapture() {
+  auto global_lock = global_critical_region_.Acquire();
+  uint32_t count = 0;
+  for (auto& entry : textures_) {
+    Texture* texture = entry.second.get();
+    if (!texture) continue;
+    const TextureKey& key = texture->key();
+    if (key.scaled_resolve) continue;
+    if (key.tiled && key.mip_max_level == 0 &&
+        key.dimension == xenos::DataDimension::k2DOrStacked) {
+      continue;
+    }
+    texture->Dbz3ForceReload(global_lock);
+    ++count;
+  }
+  texture_became_outdated_.store(true, std::memory_order_release);
+  return count;
+}
+
 void TextureCache::Dbz3MarkTextureLoaded(Texture& texture) {
   texture.MakeUpToDateAndWatch(global_critical_region_.Acquire());
 }
