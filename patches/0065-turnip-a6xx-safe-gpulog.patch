index 0000000..3125008
--- /dev/null
+++ b/include/rex/graphics/vulkan/dbz3_gpulog.h
@@ -0,0 +1,60 @@
+#pragma once
+// DBZ3-Android (0065): registo das ultimas operacoes de GPU gravadas (passes, resolves, cargas
+// de texturas, queries, submissoes) com a submissao em que foram parar. Quando a GPU cai
+// (VK_ERROR_DEVICE_LOST) o log mostra o que estava nas submissoes que nao acabaram, para se
+// saber que comando a travou sem acesso ao aparelho.
+//
+// So na thread do command processor: estado global simples, sem locks.
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+#include <rex/logging.h>
+
+namespace rex::graphics::vulkan::dbz3_gpulog {
+
+struct Entry {
+  uint64_t submission = 0;
+  std::string text;
+};
+
+inline constexpr uint32_t kSize = 256;
+inline std::array<Entry, kSize> g_ring;
+inline uint32_t g_head = 0;
+inline bool g_dumped = false;
+
+inline void Note(uint64_t submission, std::string text) {
+  Entry& e = g_ring[g_head % kSize];
+  ++g_head;
+  e.submission = submission;
+  e.text = std::move(text);
+}
+
+// Escreve no log (uma vez) as operacoes das submissoes depois de `completed`.
+inline void Dump(uint64_t completed, const char* why) {
+  if (g_dumped) return;
+  g_dumped = true;
+  REXGPU_ERROR("dbz3: GPU perdida ({}); ultima submissao concluida {}. Operacoes por concluir:",
+               why, completed);
+  const uint32_t count = g_head < kSize ? g_head : kSize;
+  uint32_t shown = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    const Entry& e = g_ring[(g_head - count + i) % kSize];
+    if (e.submission <= completed || e.text.empty()) continue;
+    REXGPU_ERROR("dbz3:   [sub {}] {}", e.submission, e.text);
+    ++shown;
+  }
+  if (!shown) {
+    // Nada registado depois da ultima concluida: mostra as ultimas 24 operacoes.
+    const uint32_t from = count > 24 ? count - 24 : 0;
+    for (uint32_t i = from; i < count; ++i) {
+      const Entry& e = g_ring[(g_head - count + i) % kSize];
+      if (e.text.empty()) continue;
+      REXGPU_ERROR("dbz3:   [sub {} (ja concluida?)] {}", e.submission, e.text);
+    }
+  }
+}
+
+}  // namespace rex::graphics::vulkan::dbz3_gpulog
