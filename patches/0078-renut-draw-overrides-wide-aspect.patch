+/**
+ * @file        core/draw_overrides.cpp
+ * @brief       DBZ3-Android (0078): per-pixel-shader draw overrides. See graphics/draw_overrides.h.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#include <rex/graphics/draw_overrides.h>
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace rex::graphics {
+
+namespace {
+using Table = std::unordered_map<uint64_t, PixelShaderDrawOverride>;
+std::mutex g_mutex;
+std::map<std::string, std::vector<PixelShaderDrawOverride>, std::less<>> g_by_owner;
+// The merged table, replaced whole on each change; readers keep their own reference.
+std::shared_ptr<const Table> g_table;
+std::atomic<uint64_t> g_version{0};
+}  // namespace
+
+void SetPixelShaderDrawOverrides(std::string_view owner, std::vector<PixelShaderDrawOverride> overrides) {
+  std::lock_guard lock(g_mutex);
+  g_by_owner[std::string(owner)] = std::move(overrides);
+  auto table = std::make_shared<Table>();
+  for (const auto& [name, list] : g_by_owner)
+    for (const auto& o : list) (*table)[o.ucode_hash] = o;
+  g_table = table->empty() ? nullptr : std::move(table);
+  g_version.fetch_add(1, std::memory_order_release);
+}
+
+const PixelShaderDrawOverride* FindPixelShaderDrawOverride(uint64_t ucode_hash) {
+  thread_local uint64_t version = 0;
+  thread_local std::shared_ptr<const Table> table;
+  const uint64_t current = g_version.load(std::memory_order_acquire);
+  if (current == 0) return nullptr;
+  if (version != current) {
+    std::lock_guard lock(g_mutex);
+    table = g_table;
+    version = g_version.load(std::memory_order_relaxed);
+  }
+  if (!table) return nullptr;
+  const auto it = table->find(ucode_hash);
+  return it == table->end() ? nullptr : &it->second;
+}
+
+}  // namespace rex::graphics
