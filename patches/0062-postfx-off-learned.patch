 // e a cadeia de brilho do jogo. Usados pelos interruptores de efeitos (dbz3_fx_*) para so
 // mexer em resolves/render targets pequenos nos frames que tem esses efeitos.
 uint64_t g_dbz3_frame_index = 0;
-uint64_t g_dbz3_fxaa_frame = 0;
