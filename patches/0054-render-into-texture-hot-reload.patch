+// ---------------------------------------------------------------------------
+// DBZ3-Android (Dragon Burst 0071-0078): passo 4, desenho direto na textura
+// (dbz3_render_into_texture).
+// O pos-processamento do BL e uma cadeia de "quad de ecra inteiro -> resolve para uma
+// textura -> o quad seguinte le essa textura". O resolve custa um fim de passe e uma copia
+// de 3,7 MB (no Mali ~0,8 ms cada, ~17 por frame). Aqui aprende-se, por assinatura do quad
+// que abre o passe (shaders, alvo, scissor), para que textura o passe acaba resolvido; com 3
+// frames iguais, o passe seguinte com essa assinatura desenha direto nessa textura e o
+// resolve e saltado. Se algo nao bater (outro resolve, a textura amostrada no proprio passe,
+// outro alvo antes do resolve, o fim do frame), desiste-se e a assinatura fica banida.
+// ---------------------------------------------------------------------------
+namespace dbz3_rit {
+struct Prediction {
+  uint32_t dest = 0;
+  uint32_t endian = 0;
+  bool swap = false;  // copy_dest_swap: R e B trocados na textura
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t hits = 0;
+  bool banned = false;
+};
+std::unordered_map<uint64_t, Prediction> g_table;
+// Passe normal em curso (para aprender).
+uint64_t g_pass_sig = 0;
+uint32_t g_pass_base = 0;
+uint32_t g_pass_pitch = 0;
+// Passe a desenhar na textura.
+bool g_active = false;
+uint64_t g_sig = 0;
+const void* g_fb = nullptr;
+void* g_tex = nullptr;
+uint32_t g_dest = 0;
+VkImageView g_view = VK_NULL_HANDLE;
+bool g_bgra = false;
+uint64_t g_soft_abort = 0;
+uint32_t g_width = 0;
+uint32_t g_height = 0;
+// Framebuffers do caminho com render passes, para destruir quando a GPU acabar.
+std::vector<std::pair<uint64_t, VkFramebuffer>> g_old_framebuffers;
+uint32_t g_base = 0;
+uint32_t g_pitch = 0;
+// Render target que ficou sem a imagem de um passe desenhado na textura.
+uint64_t g_stale_sig = 0;
+uint32_t g_stale_dest = 0;
+const void* g_stale_fb = nullptr;
+uint32_t g_stale_base = 0;
+uint32_t g_stale_pitch = 0;
+uint64_t g_stale_bans = 0;
+uint64_t g_ok = 0;
+uint64_t g_abort = 0;
+uint64_t g_learn_fail[2] = {};
+uint64_t g_begin_fail[7] = {};
+uint64_t g_frames = 0;
+
+void BanStale(const char* why) {
+  auto it = g_table.find(g_stale_sig);
+  if (it != g_table.end()) it->second.banned = true;
+  if ((g_stale_bans++ % 64) == 0) {
+    REXGPU_WARN("dbz3: render nativo: o render target ainda era preciso depois do passe {:016X} "
+                "({}); fica banido",
+                g_stale_sig, why);
+  }
+  g_stale_sig = 0;
+  g_stale_fb = nullptr;
+}
+constexpr uint32_t kHitsNeeded = 3;
+
+bool Matches(const draw_util::ResolveInfo& ri, uint32_t& width, uint32_t& height) {
+  if (ri.IsCopyingDepth() || ri.IsClearingDepth() || ri.IsClearingColor() ||
+      !ri.copy_dest_extent_length) {
+    return false;
+  }
+  const draw_util::ResolveEdramInfo& src = ri.color_edram_info;
+  if (src.msaa_samples != xenos::MsaaSamples::k1X ||
+      xenos::ColorRenderTargetFormat(src.format) != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      uint32_t(ri.copy_dest_info.copy_dest_format) != uint32_t(xenos::ColorFormat::k_8_8_8_8) ||
+      ri.copy_dest_info.copy_dest_exp_bias != 0 ||
+      ri.coordinate_info.edram_offset_x_div_8 != 0 || ri.coordinate_info.edram_offset_y_div_8 != 0 ||
+      ri.copy_dest_coordinate_info.offset_x_div_8 != 0 ||
+      ri.copy_dest_coordinate_info.offset_y_div_8 != 0) {
+    return false;
+  }
+  width = uint32_t(ri.coordinate_info.width_div_8) * 8;
+  height = ri.height_div_8 * 8;
+  return width >= 8 && height >= 8 &&
+         uint32_t(ri.copy_dest_coordinate_info.pitch_aligned_div_32) * 32 == ((width + 31) & ~31u);
+}
+
+void End(VulkanTextureCache& texture_cache) {
+  texture_cache.Dbz3EndAttachmentWrite(g_tex);
+  g_active = false;
+  g_tex = nullptr;
+  g_fb = nullptr;
+  g_view = VK_NULL_HANDLE;
+  g_bgra = false;
+}
+
+// A troca R/B que o resolve faria (como em Dbz3DirectResolve: modo 2 inverte, para testes).
+bool ResolveSwaps(const draw_util::ResolveInfo& ri) {
+  const std::string mode_text = rex::cvar::GetFlagByName("dbz3_direct_resolve_texture");
+  const bool mode2 = !mode_text.empty() && std::atoi(mode_text.c_str()) == 2;
+  return (ri.copy_dest_info.copy_dest_swap != 0) != mode2;
+}
+
+bool Resolve(VulkanRenderTargetCache& cache, const draw_util::ResolveInfo& ri,
+             VulkanTextureCache& texture_cache) {
+  uint32_t width = 0, height = 0;
+  const bool matches = Matches(ri, width, height);
+  if (!g_active && g_stale_sig && !ri.IsCopyingDepth() &&
+      ri.color_edram_info.base_tiles == g_stale_base &&
+      ri.color_edram_info.pitch_tiles == g_stale_pitch) {
+    BanStale("resolvido outra vez");
+  }
+  if (g_active) {
+    if (matches && (ri.copy_dest_base & 0x1FFFFFFF) == g_dest && ResolveSwaps(ri) == g_bgra) {
+      // O passe ja desenhou na textura: fecha-o, marca a memoria e a textura.
+      cache.Dbz3RitFinish(texture_cache, ri);
+      return true;
+    }
+    cache.Dbz3RitAbort(texture_cache, "outro resolve");
+    return false;
+  }
+  // Aprender: o passe atual (aberto por um quad a cobrir o scissor) acaba aqui.
+  const bool same_rt = (ri.color_edram_info.base_tiles == g_pass_base ||
+                        ri.color_original_base == g_pass_base) &&
+                       ri.color_edram_info.pitch_tiles == g_pass_pitch;
+  if (g_pass_sig) {
+    if (!matches) ++g_learn_fail[0];
+    else if (!same_rt) {
+      if ((g_learn_fail[1]++ % 2000) == 0) {
+        REXGPU_INFO("dbz3: passo 4: resolve de outro alvo (base {} / {} pitch {} vs passe {} {})",
+                    uint32_t(ri.color_edram_info.base_tiles), ri.color_original_base,
+                    uint32_t(ri.color_edram_info.pitch_tiles), g_pass_base, g_pass_pitch);
+      }
+    }
+  }
+  if (g_pass_sig && matches && same_rt && !dbz3_capture::WantsResolveReadback()) {
+    Prediction& p = g_table[g_pass_sig];
+    const uint32_t dest = ri.copy_dest_base & 0x1FFFFFFF;
+    const uint32_t endian = uint32_t(ri.copy_dest_info.copy_dest_endian);
+    const bool swap = ResolveSwaps(ri);
+    if (p.dest == dest && p.endian == endian && p.swap == swap && p.width == width &&
+        p.height == height) {
+      ++p.hits;
+    } else {
+      p.dest = dest;
+      p.endian = endian;
+      p.swap = swap;
+      p.width = width;
+      p.height = height;
+      p.hits = 1;
+    }
+  }
+  g_pass_sig = 0;
+  return false;
+}
+}  // namespace dbz3_rit
+
+void VulkanRenderTargetCache::Dbz3RitNormalPassStart(const void* framebuffer,
+                                                     bool full_overwrite) {
+  using namespace dbz3_rit;
+  if (!g_stale_sig || g_stale_fb != framebuffer) return;
+  if (full_overwrite) {
+    g_stale_sig = 0;  // sobrescrito: o conteudo antigo ja nao interessa
+    g_stale_fb = nullptr;
+  } else {
+    BanStale("passe que o carrega");
+  }
+}
+
+void VulkanRenderTargetCache::Dbz3RitLogFrame() {
+  using namespace dbz3_rit;
+  if ((++g_frames % 3000) != 600) return;
+  uint32_t ready = 0, banned = 0;
+  for (const auto& kv : g_table) {
+    ready += (!kv.second.banned && kv.second.hits >= kHitsNeeded) ? 1 : 0;
+    banned += kv.second.banned ? 1 : 0;
+  }
+  REXGPU_INFO("dbz3: passo 4: {} assinaturas ({} prontas, {} banidas), {} feitos, {} desistencias; "
+              "aprender falhou: resolve diferente {}, outro alvo {}; inicio falhou: sem previsao {}, "
+              "banida {}, a aprender {}, area {}, texturas {}, nao renderizavel {}, vista {}",
+              g_table.size(), ready, banned, g_ok, g_abort, g_learn_fail[0], g_learn_fail[1],
+              g_begin_fail[0], g_begin_fail[1], g_begin_fail[2], g_begin_fail[3], g_begin_fail[4],
+              g_begin_fail[5], g_begin_fail[6]);
+}
+
+void VulkanRenderTargetCache::Dbz3RitPassStart(uint64_t signature, uint32_t color_base_tiles,
+                                               uint32_t pitch_tiles) {
+  dbz3_rit::g_pass_sig = signature;
+  dbz3_rit::g_pass_base = color_base_tiles;
+  dbz3_rit::g_pass_pitch = pitch_tiles;
+}
+
+bool VulkanRenderTargetCache::Dbz3RitActive() const { return dbz3_rit::g_active; }
+
+bool VulkanRenderTargetCache::Dbz3RitIsStaleSource(uint32_t address) const {
+  return dbz3_rit::g_stale_sig && dbz3_rit::g_stale_dest == (address & 0x1FFFFFFF);
+}
+
+VkImageView VulkanRenderTargetCache::Dbz3RitContinue(const void* framebuffer) const {
+  return dbz3_rit::g_active && dbz3_rit::g_fb == framebuffer ? dbz3_rit::g_view : VK_NULL_HANDLE;
+}
+
+VkImageView VulkanRenderTargetCache::Dbz3RitBegin(VulkanTextureCache& texture_cache,
+                                                  uint64_t signature, const void* framebuffer,
+                                                  uint32_t area_right, uint32_t area_bottom,
+                                                  const uint32_t* sampled, uint32_t sampled_count,
+                                                  uint32_t color_base_tiles, uint32_t pitch_tiles) {
+  using namespace dbz3_rit;
+  // DBZ3-Android: o passo 4 nao escreve a memoria do guest (como o resolve sem memoria):
+  // so com dbz3_direct_resolve_skip_memory e nunca num destino que precisa da memoria.
+  if (g_active || !signature || IsDrawResolutionScaled() ||
+      rex::cvar::GetFlagByName("dbz3_render_into_texture") != "true" ||
+      rex::cvar::GetFlagByName("dbz3_direct_resolve_skip_memory") != "true" ||
+      dbz3_capture::WantsResolveReadback()) {
+    return VK_NULL_HANDLE;
+  }
+  auto it = g_table.find(signature);
+  if (it == g_table.end()) {
+    ++g_begin_fail[0];
+    return VK_NULL_HANDLE;
+  }
+  if (it->second.banned || it->second.hits < kHitsNeeded) {
+    ++g_begin_fail[it->second.banned ? 1 : 2];
+    return VK_NULL_HANDLE;
+  }
+  const Prediction& p = it->second;
+  if (area_right > p.width || area_bottom > p.height) {
+    ++g_begin_fail[3];
+    return VK_NULL_HANDLE;
+  }
+  if (std::find_if(g_dbz3_need_memory.begin(), g_dbz3_need_memory.end(), [&](uint32_t b) {
+        return (b & 0x1FFFFFFF) == p.dest;
+      }) != g_dbz3_need_memory.end()) {
+    it->second.banned = true;
+    return VK_NULL_HANDLE;
+  }
+  for (uint32_t i = 0; i < sampled_count; ++i) {
+    if (sampled[i] == p.dest) {
+      it->second.banned = true;  // o quad le o proprio destino
+      return VK_NULL_HANDLE;
+    }
+  }
+  void* found[4];
+  const uint32_t n = texture_cache.Dbz3FindResolveTextures(
+      p.dest, p.width, p.height, xenos::TextureFormat::k_8_8_8_8, false, xenos::Endian(p.endian),
+      found, 4);
+  if (n != 1 || !texture_cache.Dbz3TextureIsRenderable(found[0])) {
+    ++g_begin_fail[n != 1 ? 4 : 5];
+    return VK_NULL_HANDLE;
+  }
+  VkImageView view = texture_cache.Dbz3GetAttachmentView(found[0], p.swap);
+  if (view == VK_NULL_HANDLE) {
+    ++g_begin_fail[6];
+    return VK_NULL_HANDLE;
+  }
+  texture_cache.Dbz3BeginAttachmentWrite(found[0]);
+  g_active = true;
+  g_sig = signature;
+  g_fb = framebuffer;
+  g_tex = found[0];
+  g_dest = p.dest;
+  g_view = view;
+  g_bgra = p.swap;
+  g_width = p.width;
+  g_height = p.height;
+  g_pass_sig = 0;
+  g_base = color_base_tiles;
+  g_pitch = pitch_tiles;
+  return view;
+}
+
+void VulkanRenderTargetCache::Dbz3RitFinish(VulkanTextureCache& texture_cache,
+                                            const draw_util::ResolveInfo& ri) {
+  using namespace dbz3_rit;
+  command_processor_.EndRenderPass();
+  texture_cache.MarkRangeAsResolved(ri.copy_dest_extent_start, ri.copy_dest_extent_length);
+  // DBZ3-Android: como no resolve sem memoria, guarda o intervalo: se outra textura for
+  // carregada dele logo a seguir, o destino passa a precisar da memoria (e o passo 4 desiste).
+  {
+    bool found = false;
+    for (Dbz3SkippedMemoryRange& r : g_dbz3_skipped_memory) {
+      if (r.dest_base == ri.copy_dest_base) {
+        r.start = ri.copy_dest_extent_start;
+        r.length = ri.copy_dest_extent_length;
+        r.frame = g_dbz3_frame_index;
+        found = true;
+        break;
+      }
+    }
+    if (!found && g_dbz3_skipped_memory.size() < 64) {
+      g_dbz3_skipped_memory.push_back({ri.copy_dest_extent_start, ri.copy_dest_extent_length,
+                                       ri.copy_dest_base, g_dbz3_frame_index});
+    }
+  }
+  g_stale_sig = g_sig;
+  g_stale_dest = g_dest;
+  g_stale_fb = g_fb;
+  g_stale_base = g_base;
+  g_stale_pitch = g_pitch;
+  End(texture_cache);
+  // O render target nao tem esta imagem: nada de "resolve repetido" a partir dele.
+  dbz3_resolve_dedupe::g_dirty = true;
+  if ((g_ok++ % 6000) == 0) {
+    REXGPU_INFO("dbz3: render nativo: passes desenhados direto na textura: {} ({} desistencias, "
+                "{} assinaturas)",
+                g_ok, g_abort, g_table.size());
+  }
+}
+
+void VulkanRenderTargetCache::Dbz3RitAbort(VulkanTextureCache& texture_cache, const char* why) {
+  using namespace dbz3_rit;
+  if (!g_active) return;
+  command_processor_.EndRenderPass();
+  auto it = g_table.find(g_sig);
+  if (it != g_table.end()) it->second.banned = true;
+  if ((g_abort++ % 64) == 0) {
+    REXGPU_WARN("dbz3: render nativo: desenho direto na textura {:08X} abandonado ({}); "
+                "assinatura {:016X} banida",
+                g_dest, why, g_sig);
+  }
+  End(texture_cache);
+}
+
+void VulkanRenderTargetCache::Dbz3RitAbortSoft(VulkanTextureCache& texture_cache) {
+  using namespace dbz3_rit;
+  if (!g_active) return;
+  command_processor_.EndRenderPass();
+  if ((g_soft_abort++ % 256) == 0) {
+    REXGPU_INFO("dbz3: render nativo: pipeline BGRA ainda a compilar, passe {:016X} pelo caminho "
+                "normal ({} vezes)",
+                g_sig, g_soft_abort);
+  }
+  End(texture_cache);
+}
+
+bool VulkanRenderTargetCache::Dbz3RitBgra() const { return dbz3_rit::g_active && dbz3_rit::g_bgra; }
+
+bool VulkanRenderTargetCache::Dbz3RitRenderPassFor(RenderPassKey key, VkRenderPass& render_pass_out,
+                                                   VkFramebuffer& framebuffer_out,
+                                                   VkExtent2D& extent_out) {
+  using namespace dbz3_rit;
+  if (!g_active || g_view == VK_NULL_HANDLE || !g_width || !g_height) return false;
+  // So passes so com a cor 0 (o pos do BL): a profundidade do render target nao entra.
+  if (key.depth_and_color_used != 0b10) return false;
+  key.dbz3_color_0_bgra = g_bgra ? 1 : 0;
+  VkRenderPass render_pass = GetHostRenderTargetsRenderPass(key);
+  if (render_pass == VK_NULL_HANDLE) return false;
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint64_t completed = command_processor_.GetCompletedSubmission();
+  auto end = std::remove_if(g_old_framebuffers.begin(), g_old_framebuffers.end(),
+                            [&](const std::pair<uint64_t, VkFramebuffer>& f) {
+                              if (f.first > completed) return false;
+                              dfn.vkDestroyFramebuffer(device, f.second, nullptr);
+                              return true;
+                            });
+  g_old_framebuffers.erase(end, g_old_framebuffers.end());
+  VkFramebufferCreateInfo info = {};
+  info.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+  info.renderPass = render_pass;
+  info.attachmentCount = 1;
+  info.pAttachments = &g_view;
+  info.width = g_width;
+  info.height = g_height;
+  info.layers = 1;
+  VkFramebuffer framebuffer;
+  if (dfn.vkCreateFramebuffer(device, &info, nullptr, &framebuffer) != VK_SUCCESS) return false;
+  g_old_framebuffers.emplace_back(command_processor_.GetCurrentSubmission(), framebuffer);
+  render_pass_out = render_pass;
+  framebuffer_out = framebuffer;
+  extent_out = {g_width, g_height};
+  return true;
+}
+
+void VulkanRenderTargetCache::Dbz3RitOnSample(VulkanTextureCache& texture_cache,
+                                              uint32_t address) {
+  using namespace dbz3_rit;
+  if (g_active) {
