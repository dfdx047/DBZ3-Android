diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 302128d..b00f774 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -95,6 +95,26 @@ class SharedMemory {
   // regions in those pages.
   void RangeWrittenByGpu(uint32_t start, uint32_t length);
 
+  // DBZ3-Android (0069): o intervalo tem paginas escritas pela GPU (resolves)? Nesse caso a
+  // memoria do guest no CPU nao tem os dados atuais.
+  bool Dbz3RangeHasGpuWrittenPages(uint32_t start, uint32_t length) {
+    if (!length || start >= kBufferSize) {
+      return true;
+    }
+    length = std::min(length, kBufferSize - start);
+    const uint32_t page_first = start >> page_size_log2_;
+    const uint32_t page_last = (start + length - 1) >> page_size_log2_;
+    auto global_lock = global_critical_region_.Acquire();
+    for (uint32_t page = page_first; page <= page_last; ++page) {
+      const size_t block = page >> 6;
+      if (block >= system_page_flags_valid_and_gpu_written_.size() ||
+          ((system_page_flags_valid_and_gpu_written_[block] >> (page & 63)) & 1)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
  protected:
   SharedMemory(memory::Memory& memory);
   // Call in implementation-specific initialization.
