+// Dragon Fury: o som dos modos de PS2 no Android. No PC e winmm (PlaySound/waveOut), uma saida por som e fora da mistura do
+// jogo; aqui e o mesmo com um stream AAudio por som. vivo() falso corta. Pausa junto com o jogo (menu ou app em segundo plano).
+void TocarPcm(const int16_t* pcm, size_t muestras, int hz, int canales, bool bucle, const std::function<bool()>& vivo) {
+  if (!pcm || !muestras || hz <= 0) return;
+  AAudioStreamBuilder* b = nullptr;
+  if (AAudio_createStreamBuilder(&b) != AAUDIO_OK) return;
+  AAudioStreamBuilder_setFormat(b, AAUDIO_FORMAT_PCM_I16);
+  AAudioStreamBuilder_setChannelCount(b, canales);
+  AAudioStreamBuilder_setSampleRate(b, hz);
+  AAudioStreamBuilder_setUsage(b, AAUDIO_USAGE_GAME);
+  AAudioStreamBuilder_setContentType(b, AAUDIO_CONTENT_TYPE_MUSIC);
+  AAudioStream* st = nullptr;
+  const aaudio_result_t r = AAudioStreamBuilder_openStream(b, &st);
+  AAudioStreamBuilder_delete(b);
+  if (r != AAUDIO_OK || !st) {
+    REXLOG_WARN("dbz3 pasarela: AAudio: {}", AAudio_convertResultToText(r));
+    return;
+  }
+  AAudioStream_requestStart(st);
+  const size_t total = muestras / size_t(canales);
+  size_t pos = 0;
+  bool parado = false, acabo = false;
+  while (vivo()) {
+    if (g_dragonfury_pause.load()) {
+      if (!parado) AAudioStream_requestPause(st);
+      parado = true;
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+      continue;
+    }
+    if (parado) AAudioStream_requestStart(st);
+    parado = false;
+    if (pos >= total) {
+      if (!bucle) {
+        acabo = true;
+        break;
+      }
+      pos = 0;
+    }
+    const auto n = AAudioStream_write(st, pcm + pos * size_t(canales), int32_t(std::min<size_t>(total - pos, 4800)), 100000000LL);
+    if (n < 0) {   // AAUDIO_ERROR_DISCONNECTED: mudou a saida (fones); este som acaba aqui
+      REXLOG_WARN("dbz3 pasarela: AAudio: {}", AAudio_convertResultToText(n));
+      break;
+    }
+    pos += size_t(n);
+  }
+  if (acabo) {   // deixa tocar o que ficou no buffer
+    const int32_t resto = AAudioStream_getBufferSizeInFrames(st);
+    std::this_thread::sleep_for(std::chrono::milliseconds(int64_t(resto) * 1000 / hz + 20));
+  }
+  AAudioStream_requestStop(st);
+  AAudioStream_close(st);
+}
+#endif
