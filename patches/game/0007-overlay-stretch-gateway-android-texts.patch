diff --git a/src/ingame/game_style.cpp b/src/ingame/game_style.cpp
index e405bdf..3d57514 100644
--- a/src/ingame/game_style.cpp
+++ b/src/ingame/game_style.cpp
@@ -93,6 +93,21 @@ Imagen GuestImage(const ImGuiIO& io) {
   return g;
 }
 
+Area GameAreaUniforme(const ImGuiIO& io) {
+  const Imagen g = GuestImage(io);
+  const ImVec2 sz = g.Size();
+  float h = sz.y, w = h * 4.0f / 3.0f;
+  if (w > sz.x) {
+    w = sz.x;
+    h = w * 0.75f;
+  }
+  Area a;
+  a.p0 = ImVec2(g.p0.x + (sz.x - w) * 0.5f, g.p0.y + (sz.y - h) * 0.5f);
+  a.p1 = ImVec2(a.p0.x + w, a.p0.y + h);
+  a.s = a.sx = a.sy = h / 900.0f;
+  return a;
+}
+
 Area GameArea(const ImGuiIO& io) {
   // S1-F06: el area 4:3 de los menus del juego es el centro de su imagen 16:9 (3/4 del ancho, todo el alto)
   Area a;
@@ -103,9 +118,23 @@ Area GameArea(const ImGuiIO& io) {
     w = sz.x;
     h = w * 0.75f;
   }
+  // Dragon Fury: "stretch" estica a imagem 16:9 inteira para a janela (no Cube, 1:1): as coordenadas do jogo seguem-na, com uma
+  // escala em cada eixo; o tamanho de letra e de imagens (s) fica na menor, para caber onde o jogo desenha as suas caixas.
+  static const bool baja_res = dbz3::settings::LowResEnabled();
+  if (dbz3::settings::AspectMode() == "stretch" && sz.x > 0 && sz.y > 0) {
+    w = baja_res ? sz.x : sz.x * 0.75f;
+    h = sz.y;
+    a.p0 = ImVec2(g.p0.x + (sz.x - w) * 0.5f, g.p0.y);
+    a.p1 = ImVec2(a.p0.x + w, a.p0.y + h);
+    a.sx = w / 1200.0f;
+    a.sy = h / 900.0f;
+    a.s = std::min(a.sx, a.sy);
+    return a;
+  }
   a.p0 = ImVec2(g.p0.x + (sz.x - w) * 0.5f, g.p0.y + (sz.y - h) * 0.5f);
   a.p1 = ImVec2(a.p0.x + w, a.p0.y + h);
   a.s = h / 900.0f;
+  a.sx = a.sy = a.s;
   return a;
 }
 
