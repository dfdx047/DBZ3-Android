+// ---------------------------------------------------------------------------
+// DBZ3-Android (Dragon Burst 0068/0069): resolves repetidos ou sem leitor (dbz3_resolve_dedupe).
+// 1) Repetido: sem draws desde o ultimo resolve e com os mesmos parametros, o render
+//    target tem o mesmo conteudo - se o destino ja o recebeu, nao ha nada a copiar.
+// 2) Sem leitor: um destino cujas escritas so sao lidas por draws saltados (efeitos
+//    desligados, restauros e pre-passos saltados) durante 120 escritas
+//    seguidas deixa de ser resolvido. Escritas sem leitor nenhum nao contam (ex.: o brilho
+//    entre rounds, quando a composicao nao corre - os logs de 16/10 07:32 mostraram que
+//    "nenhum leitor" sozinho apanhava destinos que voltam a ser lidos). Se um draw feito o
+//    voltar a ler, volta a ser resolvido (esse frame usa o conteudo antigo).
+// ---------------------------------------------------------------------------
+namespace dbz3_resolve_dedupe {
+bool g_dirty = true;
+uint64_t g_null_draws = 0;
+uint64_t g_same = 0;
+uint64_t g_dead = 0;
+uint64_t g_revived = 0;
+uint64_t g_frames = 0;
+
+constexpr uint32_t kDeadStreak = 120;
+
+struct Entry {
+  uint32_t start = 0;
+  uint32_t length = 0;
+  uint32_t streak = 0;
+  bool written = false;
+  bool read = false;
+  bool skipped_read = false;
+  bool dead = false;
+};
+std::vector<Entry> g_entries;
+bool g_key_valid = false;
+uint32_t g_key[7] = {};
+std::vector<uint32_t> g_holders;
+
+void MarkRead(uint32_t address) {
+  for (Entry& e : g_entries) {
+    if (address >= e.start && address < e.start + e.length) {
+      e.read = true;
+      if (e.dead) {
+        e.dead = false;
+        e.streak = 0;
+        if ((g_revived++ % 64) == 0) {
+          REXGPU_INFO("dbz3: resolves: {:08X} voltou a ser lido, volta a ser resolvido", e.start);
+        }
+      }
+    }
+  }
+}
+
+void MarkSkippedRead(uint32_t address) {
+  for (Entry& e : g_entries) {
+    if (address >= e.start && address < e.start + e.length) e.skipped_read = true;
+  }
+}
+
+void LogFrame() {
+  if ((++g_frames % 3000) == 1) {
+    uint32_t dead = 0;
+    for (const Entry& e : g_entries) dead += e.dead ? 1 : 0;
+    REXGPU_INFO(
+        "dbz3: dedupe: {} draws nulos, {} resolves repetidos e {} sem leitor saltados "
+        "({} destinos sem leitor agora)",
+        g_null_draws, g_same, g_dead, dead);
+  }
+}
+
+bool Resolve(const draw_util::ResolveInfo& ri, bool may_skip) {
+  const uint32_t start = ri.copy_dest_extent_start & 0x1FFFFFFF;
+  const uint32_t length = ri.copy_dest_extent_length;
+  const draw_util::ResolveEdramInfo& src = ri.IsCopyingDepth() ? ri.depth_edram_info : ri.color_edram_info;
+  const uint32_t key[7] = {ri.rb_copy_control.value, ri.copy_dest_info.value, src.packed,
+                           ri.coordinate_info.packed, ri.height_div_8,
+                           ri.copy_dest_coordinate_info.packed, ri.copy_dest_base - ri.copy_dest_extent_start};
+  const bool clears = ri.IsClearingColor() || ri.IsClearingDepth();
+  const bool same_content = g_key_valid && !g_dirty && std::memcmp(key, g_key, sizeof(key)) == 0;
+  if (may_skip && same_content &&
+      std::find(g_holders.begin(), g_holders.end(), start) != g_holders.end()) {
+    ++g_same;
+    return true;
+  }
+  Entry* e = nullptr;
+  for (Entry& it : g_entries) {
+    if (it.start == start) {
+      e = &it;
+      break;
+    }
+  }
+  if (!e) {
+    if (g_entries.size() >= 256) g_entries.erase(g_entries.begin());
+    g_entries.push_back(Entry{start, length});
+    e = &g_entries.back();
+  }
+  e->length = std::max(e->length, length);
+  if (e->written) {
+    if (e->read || !e->skipped_read) {
+      e->streak = 0;
+      if (e->dead && !e->read) {
+        // Sem leitor nenhum desta vez: fica como esta (nao conta para nenhum lado).
+        e->streak = kDeadStreak;
+      }
+    } else if (++e->streak >= kDeadStreak && !e->dead) {
+      e->dead = true;
+      REXGPU_INFO("dbz3: resolves: {:08X} ({} KB) sem leitor ha {} escritas, deixa de ser resolvido",
+                  start, length >> 10, e->streak);
+    }
+  }
+  e->written = true;
+  e->read = false;
+  e->skipped_read = false;
+  // Quem tem agora o conteudo do render target (para o caso 1).
+  if (!same_content) {
+    g_holders.clear();
+    std::memcpy(g_key, key, sizeof(key));
+    g_key_valid = true;
+  }
+  g_dirty = clears;  // um clear muda o render target depois da copia
+  g_holders.erase(std::remove(g_holders.begin(), g_holders.end(), start), g_holders.end());
+  if (may_skip && e->dead) {
+    ++g_dead;
+    return true;  // o destino fica com o conteudo antigo: nao entra nos que o tem
+  }
+  g_holders.push_back(start);
+  return false;
+}
+}  // namespace dbz3_resolve_dedupe
+
+
 }  // namespace rex::graphics::vulkan
