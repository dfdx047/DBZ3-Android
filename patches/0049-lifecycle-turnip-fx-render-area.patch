+  if (!app_dir || !*app_dir) {
+    return;
+  }
+  std::string path = std::string(app_dir) + "/logs/vulkan_driver_status.txt";
+  if (FILE* f = std::fopen(path.c_str(), "w")) {
+    std::fprintf(f, "%s\n%s\n%s\n", ok ? "ok" : "falhou", driver.c_str(), detail.c_str());
