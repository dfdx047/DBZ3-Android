+void VulkanCommandProcessor::Dbz3AreaAdd(int32_t x0, int32_t y0, int32_t x1, int32_t y1) {
+  if (!dbz3_area_active_ || x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  if (!dbz3_area_has_) {
+    dbz3_area_has_ = true;
+    dbz3_area_x0_ = x0;
+    dbz3_area_y0_ = y0;
+    dbz3_area_x1_ = x1;
+    dbz3_area_y1_ = y1;
+    return;
+  }
+  dbz3_area_x0_ = std::min(dbz3_area_x0_, x0);
+  dbz3_area_y0_ = std::min(dbz3_area_y0_, y0);
+  dbz3_area_x1_ = std::max(dbz3_area_x1_, x1);
+  dbz3_area_y1_ = std::max(dbz3_area_y1_, y1);
+}
+
+void VulkanCommandProcessor::Dbz3AreaApplyBeforePassEnd() {
+  const bool active = dbz3_area_active_;
+  dbz3_area_active_ = false;
+  if (!active || !dbz3_area_has_ || !in_render_pass_ || !current_framebuffer_ ||
+      render_pass_begin_position_ == SIZE_MAX) {
+    return;
+  }
+  VkRect2D* area = deferred_command_buffer_.Dbz3FindBeginRenderArea(render_pass_begin_position_);
+  if (!area) {
+    return;
+  }
+  const int32_t fb_w = int32_t(current_framebuffer_->host_extent.width);
+  const int32_t fb_h = int32_t(current_framebuffer_->host_extent.height);
+  // Alinhado a 32 pixeis (tiles do Mali 16x16, bins do Adreno multiplos de 32).
+  const int32_t x0 = std::clamp(dbz3_area_x0_ & ~31, 0, fb_w);
+  const int32_t y0 = std::clamp(dbz3_area_y0_ & ~31, 0, fb_h);
+  const int32_t x1 = std::clamp((dbz3_area_x1_ + 31) & ~31, 0, fb_w);
+  const int32_t y1 = std::clamp((dbz3_area_y1_ + 31) & ~31, 0, fb_h);
+  if (x1 <= x0 || y1 <= y0) {
+    return;
+  }
+  area->offset.x = x0;
+  area->offset.y = y0;
+  area->extent.width = uint32_t(x1 - x0);
+  area->extent.height = uint32_t(y1 - y0);
+}
