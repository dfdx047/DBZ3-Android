+// DBZ3-Android (0060): GPU time of the frames the profiler measured (dbz3_perf_logging), totals
+// since startup in microseconds: [0] frames, [1] total, [2..7] per category (other, draw,
+// transfer, resolve, textures, swap). The render self-test takes differences per state.
+constexpr size_t kGpuTotalsCount = 8;
+void AddGpuFrame(double total_ms, const double* category_ms, size_t category_count);
