diff --git a/src/core/perf/frame_rate.cpp b/src/core/perf/frame_rate.cpp
index 53f9166..9ab56ee 100644
--- a/src/core/perf/frame_rate.cpp
+++ b/src/core/perf/frame_rate.cpp
@@ -113,4 +113,23 @@ std::string GetPresentInfo() {
   return g_present_info;
 }
 
+namespace {
+std::array<std::atomic<uint64_t>, kGpuTotalsCount> g_gpu_totals{};
+}  // namespace
+
+void AddGpuFrame(double total_ms, const double* category_ms, size_t category_count) {
+  g_gpu_totals[0].fetch_add(1, std::memory_order_relaxed);
+  g_gpu_totals[1].fetch_add(uint64_t(std::max(total_ms, 0.0) * 1000.0), std::memory_order_relaxed);
+  for (size_t i = 0; i < category_count && i + 2 < kGpuTotalsCount; ++i) {
+    g_gpu_totals[i + 2].fetch_add(uint64_t(std::max(category_ms[i], 0.0) * 1000.0),
+                                  std::memory_order_relaxed);
+  }
+}
+
+void GetGpuTotals(uint64_t* out, size_t count) {
+  for (size_t i = 0; i < count && i < kGpuTotalsCount; ++i) {
+    out[i] = g_gpu_totals[i].load(std::memory_order_relaxed);
+  }
+}
+
 }  // namespace rex::perf
