+HostSurface *DepthAliasLocked(const HostSurface *surface) {
+  if (!surface || surface->depth)
+    return nullptr;
+  // TargetKey: base, pitch and samples in bits 0-27, depth in 28, scale in 29-31.
+  constexpr uint64_t kViewMask = 0xEFFFFFFFull;
+  for (const auto &[key, target] : g_targets) {
+    if (target.get() != surface)
+      continue;
+    for (const auto &[other_key, other] : g_targets)
+      if (other && other->depth && other->texture && (other_key & kViewMask) == (key & kViewMask))
+        return other.get();
+    return nullptr;
+  }
+  return nullptr;
+}
