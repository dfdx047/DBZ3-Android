+++ b/app/src/renut_engine/gpu/shaders/host/depth_restore_ps.hlsl
@@ -0,0 +1,11 @@
+// Dragon Fury (2026-10-30): a depth resolve written back into a depth target (draw.cpp, RestoreDepthThroughColorLocked).
+// The Budokai put a depth buffer back by drawing its resolve as colour over the depth buffer's EDRAM; here the
+// resolve's float (depth_resolve.hlsli: the depth it loaded) becomes the depth again. The destination pixel plus
+// g_Push.translate is the source texel; present_vs draws the fullscreen triangle. The stencil is left as it is.
+#include "utility.hlsli"
+
+float main(float4 position : SV_Position) : SV_Depth
+{
+    const int2 texel = int2(position.xy) + int2(g_Push.translate);
+    return g_Textures[g_Push.textureIndex].Load(int3(texel, 0)).x;
+}
