+// Dragon Fury (2026-10-30): the Budokai put a depth buffer back by drawing it as colour. After the frame's first pass
+// they resolve the depth (a whole depth resolve), clear, and later draw that resolve's memory, sampled as 8_8_8_8,
+// into a colour surface over the depth buffer's EDRAM (no depth bound): on the console the words land in the depth
+// tiles, and the second pass (the Dragon Universe map's sky and clouds) tests against the depth as it was resolved.
+// Here colour and depth targets are separate images, so the depth kept what the first pass left: the sky failed its
+// test in blocks, black where the clear showed through. The draw becomes a copy of the depth image the resolve's
+// destination holds (the hand-over keeps it whole: handed_from or held) into the depth target. false: drawn as is.
+bool RestoreDepthThroughColorLocked(const GuestDevice &device, const ShaderRecord *ps) {
+  if (!ps || !ps->entry || device.U32(d3d::kDeviceOffsetDepthStencil) ||
+      device.U32(d3d::kDeviceOffsetRenderTargets + 4))
+    return false;
+  const u32 color_va = device.U32(d3d::kDeviceOffsetRenderTargets);
+  HostSurface *color = color_va ? FindHostSurfaceLocked(color_va) : nullptr;
+  HostSurface *depth = DepthAliasLocked(color);
+  if (!depth || depth->samples != plume::RenderSampleCount::COUNT_1)
+    return false;
+  HostTexture *dest = nullptr;
+  for (u32 bits = ps->entry->textureFetchMask; bits && !dest; bits &= bits - 1) {
+    const u32 r = u32(__builtin_ctz(bits));
+    const TextureFetch fetch = DeviceTextureFetch(device.dev(), r);
+    if (fetch.Type() == 2)
+      dest = DepthResolveAtPageLocked(fetch.BasePage());
+  }
+  if (!dest || dest->width != depth->width || dest->height != depth->height) {
+    static uint32_t logged_dest = 0;
+    if (logged_dest++ < 8) {
+      std::string pages;
+      for (u32 bits = ps->entry->textureFetchMask; bits; bits &= bits - 1) {
+        const TextureFetch fetch = DeviceTextureFetch(device.dev(), u32(__builtin_ctz(bits)));
+        pages += fmt::format(" t{} type {} page {:05X}", __builtin_ctz(bits), fetch.Type(), fetch.BasePage());
+      }
+      RGPU_INFO("[df-depth] colour {:08X} over depth {:08X}: no depth resolve sampled ({}){}", color_va,
+                depth->guest_va, dest ? "size" : "none", pages);
+    }
+    return false;
+  }
+  const uint32_t w = depth->scale.Size(depth->width), h = depth->scale.Size(depth->height);
+  {
+    static uint32_t logged_src = 0;
+    if (logged_src++ < 4)
+      RGPU_INFO("[df-depth] colour {:08X} over depth {:08X}, resolve {:08X}: handed {} held {}", color_va,
+                depth->guest_va, dest->guest_va, dest->handed_from ? dest->handed_from->guest_va : 0,
+                dest->held && dest->held_current ? 1 : 0);
+  }
+  auto &s = State();
+  plume::RenderCommandList *cmd = Video::CommandListLocked();
+  if (!cmd)
+    return false;
+  // The content is in a target's image (the hand-over): copied whole.
+  plume::RenderTexture *source = nullptr;
+  if (HostSurface *from = dest->handed_from) {
+    if (!from->texture || from->generation != dest->handed_generation || from->writes != dest->handed_writes ||
+        from->format != depth->format || from->samples != depth->samples || from->scale.code != depth->scale.code ||
+        from->width != depth->width || from->height != depth->height)
+      return false;
+    if (from == depth)
+      return true;  // the depth buffer still holds it
+    TransitionSurfaceLocked(from, plume::RenderTextureLayout::COPY_SOURCE);
+    source = from->texture.get();
+  } else if (dest->held && dest->held_current && dest->held->texture) {
+    DepthImage &image = *dest->held;
+    if (image.format != depth->format || image.samples != depth->samples || image.host_width != w ||
+        image.host_height != h)
+      return false;
+    if (image.layout != plume::RenderTextureLayout::COPY_SOURCE) {
+      cmd->barriers(plume::RenderBarrierStage::COPY,
+                    plume::RenderTextureBarrier(image.texture.get(), plume::RenderTextureLayout::COPY_SOURCE));
+      image.layout = plume::RenderTextureLayout::COPY_SOURCE;
+    }
+    source = image.texture.get();
+  }
+  DepthHandOverBeforeBindLocked(depth, nullptr, 0);  // what others hold of its content, first
+  if (source) {
+    TransitionSurfaceLocked(depth, plume::RenderTextureLayout::COPY_DEST);
+    cmd->copyTexture(depth->texture.get(), source);
+  } else {
+    // Drawn: the resolve's float, the depth it loaded, written as the depth (depth_restore_ps.hlsl).
+    if (!s.depth_restore_ps || !dest->texture || dest->scale.code != depth->scale.code ||
+        dest->alloc_width < w || dest->alloc_height < h)
+      return false;
+    auto &pipeline = s.depth_restore_pipelines[uint32_t(depth->format)];
+    if (!pipeline) {
+      plume::RenderGraphicsPipelineDesc desc;
+      desc.pipelineLayout = s.utility_layout.get();
+      desc.vertexShader = s.present_vs.get();
+      desc.pixelShader = s.depth_restore_ps.get();
+      desc.primitiveTopology = plume::RenderPrimitiveTopology::TRIANGLE_LIST;
+      desc.cullMode = plume::RenderCullMode::NONE;
+      desc.renderTargetCount = 0;
+      desc.depthTargetFormat = depth->format;
+      desc.depthEnabled = true;
+      desc.depthWriteEnabled = true;
+      desc.depthFunction = plume::RenderComparisonFunction::ALWAYS;
+      pipeline = s.device->createGraphicsPipeline(desc);
+      if (!pipeline)
+        return false;
+      pipeline->setName("renut depth restore");
+    }
+    const uint32_t slot = PlainSlotLocked(*dest);
+    if (slot == UINT32_MAX || slot == kInvalidDescriptor)
+      return false;
+    Targets t;
+    t.depth = depth;
+    t.width = depth->width;
+    t.height = depth->height;
+    t.scale = depth->scale;
+    t.guest_width = depth->width;
+    t.guest_height = depth->height;
+    TransitionTextureLocked(dest, plume::RenderTextureLayout::SHADER_READ);
+    if (!BindTargets(t))
+      return false;
+    cmd->setViewports(plume::RenderViewport(0.0f, 0.0f, float(w), float(h)));
+    cmd->setScissors(plume::RenderRect(0, 0, int32_t(w), int32_t(h)));
+    cmd->setGraphicsPipelineLayout(s.utility_layout.get());
+    cmd->setPipeline(pipeline.get());
+    cmd->setGraphicsDescriptorSet(s.texture_set.get(), 0);
+    cmd->setGraphicsDescriptorSet(s.sampler_set.get(), 1);
+    UtilityPush push{};
+    push.scale[0] = push.scale[1] = 1.0f;
+    push.texture_index = slot;
+    push.sampler_index = kPointClampSamplerSlot;
+    cmd->setGraphicsPushConstants(0, &push, 0, sizeof(push));
+    cmd->drawInstanced(3, 1, 0, 0);
+    // The draw path binds its own layout, pipeline, targets and viewport again.
+    g_bound.framebuffer = nullptr;
+    g_bound.pipeline = nullptr;
+    g_bound.layout = false;
+    g_bound.viewport_set = false;
+  }
+  ++depth->writes;
+  static uint32_t logged = 0;
+  if (logged++ < 4)
+    RGPU_INFO("[df-depth] depth {:08X} restored from depth resolve {:08X} ({}x{}, {})", depth->guest_va,
+              dest->guest_va, depth->width, depth->height, source ? "copied" : "drawn");
+  return true;
+}
