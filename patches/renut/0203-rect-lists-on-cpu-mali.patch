+namespace {
+float HalfToFloat(uint16_t h) {
+  const u32 sign = u32(h & 0x8000) << 16, exponent = (h >> 10) & 0x1F, mantissa = h & 0x3FF;
+  u32 bits;
+  if (!exponent)
+    return (h & 0x8000 ? -1.0f : 1.0f) * float(mantissa) * 5.9604644775390625e-8f;  // 2^-24
+  if (exponent == 31)
+    bits = sign | 0x7F800000u | (mantissa << 13);
+  else
+    bits = sign | ((exponent + 112) << 23) | (mantissa << 13);
+  float f;
+  std::memcpy(&f, &bits, 4);
+  return f;
+}
+
+uint16_t FloatToHalf(float f) {
+  u32 bits;
+  std::memcpy(&bits, &f, 4);
+  const u32 sign = (bits >> 16) & 0x8000;
+  const int32_t exponent = int32_t((bits >> 23) & 0xFF) - 112;
+  if (exponent <= 0)
+    return uint16_t(sign);
+  if (exponent >= 31)
+    return uint16_t(sign | 0x7C00);
+  return uint16_t(sign | (u32(exponent) << 10) | ((bits >> 13) & 0x3FF));
+}
+
+// d = a + b - c for one host vertex element (its host format), clamped where the format is normalized.
+void OppositeElement(const HostVertexElement &e, u8 *d, const u8 *a, const u8 *b, const u8 *c) {
+  using F = plume::RenderFormat;
+  switch (e.host_format) {
+  case F::R32_FLOAT:
+  case F::R32G32_FLOAT:
+  case F::R32G32B32_FLOAT:
+  case F::R32G32B32A32_FLOAT:
+    for (u32 i = 0; i < e.host_size / 4; ++i) {
+      float x, y, z;
+      std::memcpy(&x, a + i * 4, 4);
+      std::memcpy(&y, b + i * 4, 4);
+      std::memcpy(&z, c + i * 4, 4);
+      const float r = x + y - z;
+      std::memcpy(d + i * 4, &r, 4);
+    }
+    return;
+  case F::R16G16_FLOAT:
+  case F::R16G16B16A16_FLOAT:
+    for (u32 i = 0; i < e.host_size / 2; ++i) {
+      uint16_t x, y, z;
+      std::memcpy(&x, a + i * 2, 2);
+      std::memcpy(&y, b + i * 2, 2);
+      std::memcpy(&z, c + i * 2, 2);
+      const uint16_t r = FloatToHalf(HalfToFloat(x) + HalfToFloat(y) - HalfToFloat(z));
+      std::memcpy(d + i * 2, &r, 2);
+    }
+    return;
+  case F::R8G8B8A8_UNORM:
+  case F::B8G8R8A8_UNORM:
+    for (u32 i = 0; i < e.host_size; ++i)
+      d[i] = u8(std::clamp(int32_t(a[i]) + int32_t(b[i]) - int32_t(c[i]), 0, 255));
+    return;
+  case F::R8G8B8A8_SNORM:
+    for (u32 i = 0; i < e.host_size; ++i)
+      d[i] = u8(int8_t(std::clamp(int32_t(int8_t(a[i])) + int32_t(int8_t(b[i])) - int32_t(int8_t(c[i])), -127, 127)));
+    return;
+  case F::R16G16_UNORM:
+  case F::R16G16B16A16_UNORM:
+  case F::R16G16_SNORM:
+  case F::R16G16B16A16_SNORM: {
+    const bool snorm = e.host_format == F::R16G16_SNORM || e.host_format == F::R16G16B16A16_SNORM;
+    for (u32 i = 0; i < e.host_size / 2; ++i) {
+      uint16_t x, y, z;
+      std::memcpy(&x, a + i * 2, 2);
+      std::memcpy(&y, b + i * 2, 2);
+      std::memcpy(&z, c + i * 2, 2);
+      const int32_t r = snorm ? std::clamp(int32_t(int16_t(x)) + int16_t(y) - int16_t(z), -32767, 32767)
+                              : std::clamp(int32_t(x) + int32_t(y) - int32_t(z), 0, 65535);
+      const uint16_t out = uint16_t(r);
+      std::memcpy(d + i * 2, &out, 2);
+    }
+    return;
+  }
+  default:
+    std::memcpy(d, c, e.host_size);
+    return;
+  }
+}
