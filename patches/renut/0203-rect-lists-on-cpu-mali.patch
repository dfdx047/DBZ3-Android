+// Dragon Fury (2026-10-30): a rectangle list's streams (RectangleListOnCpu): the guest vertices converted now, each
+// rectangle's fourth corner after them, and the two triangles of each as indices (the strip rectangle_list_gs emits:
+// the right angle c, then a, b, and d across from c).
+bool BindRectangleStreams(const GuestDevice &device, const DrawCall &call, const ShaderRecord &vs,
+                          const u32 *shader_strides, const HostVertexLayout &layout, Geometry &g) {
+  plume::RenderCommandList *cmd = State().command_list;
+  const u32 count = g.vertex_range, rects = g.rect_count;
+  struct Converted {
+    const HostVertexStream *hs = nullptr;
+    u8 *host = nullptr;
+  };
+  Converted converted[kMaxVertexStreams];
+  u32 converted_count = 0;
+  const HostVertexElement *position = nullptr;
+  const u8 *position_base = nullptr;
+  u32 position_stride = 0;
+  for (u32 left = layout.used_mask; left; left &= left - 1) {
+    const u32 stream = u32(std::countr_zero(left));
+    const HostVertexStream &hs = layout.streams[stream];
+    if (!hs.used)
+      continue;
+    const StreamSource src = GetStreamSource(device, call, vs, shader_strides, stream);
+    const bool constant = src.stride == 0;
+    const u32 first = constant ? 0 : g.first_vertex;
+    u32 have = constant ? 1 : count;
+    if (first < src.vertex_count)
+      have = std::min(have, src.vertex_count - first);
+    else
+      have = 0;
+    const u32 vertices = constant ? 1 : count + rects;
+    const u32 bytes = std::max<u32>(vertices, 1) * hs.host_stride;
+    UploadAllocation alloc = Video::UploadsLocked().Allocate(bytes, 16);
+    if (!alloc)
+      return false;
+    auto *host = static_cast<u8 *>(alloc.cpu);
+    std::memset(host, 0, bytes);
+    if (src.data && have)
+      ConvertVertices(hs, src.data + size_t(first) * src.stride, src.stride, have, src.endian, host);
+    if (!constant) {
+      converted[converted_count++] = {&hs, host};
+      for (const HostVertexElement &e : hs.elements)
+        if (e.usage == 0 && e.usage_index == 0  /* Position */ && !position) {
+          position = &e;
+          position_base = host;
+          position_stride = hs.host_stride;
+        }
+    }
+    const plume::RenderVertexBufferView view(alloc.ref, bytes);
+    const plume::RenderInputSlot slot(stream, constant ? 0 : hs.host_stride,
+                                      plume::RenderInputSlotClassification::PER_VERTEX_DATA);
+    SetVertexBuffer(cmd, view, slot);
+  }
+  const bool wide = count + rects > 0xFFFE;
+  const u32 index_bytes = rects * 6 * (wide ? 4 : 2);
+  UploadAllocation indices = Video::UploadsLocked().Allocate(index_bytes, 16);
+  if (!indices)
+    return false;
+  for (u32 r = 0; r < rects; ++r) {
+    u32 corner = 0;
+    if (position) {
+      const u8 *v[3] = {position_base + size_t(r * 3) * position_stride,
+                        position_base + size_t(r * 3 + 1) * position_stride,
+                        position_base + size_t(r * 3 + 2) * position_stride};
+      corner = RightAngleCorner(position, v);
+    }
+    const u32 c = r * 3 + corner, a = r * 3 + (corner + 1) % 3, b = r * 3 + (corner + 2) % 3, d = count + r;
+    for (u32 i = 0; i < converted_count; ++i) {
+      const HostVertexStream &hs = *converted[i].hs;
+      u8 *base = converted[i].host;
+      for (const HostVertexElement &e : hs.elements)
+        OppositeElement(e, base + size_t(d) * hs.host_stride + e.host_offset,
+                        base + size_t(a) * hs.host_stride + e.host_offset,
+                        base + size_t(b) * hs.host_stride + e.host_offset,
+                        base + size_t(c) * hs.host_stride + e.host_offset);
+    }
+    const u32 tri[6] = {c, a, b, b, a, d};
+    for (u32 k = 0; k < 6; ++k) {
+      if (wide)
+        static_cast<u32 *>(indices.cpu)[r * 6 + k] = tri[k];
+      else
+        static_cast<uint16_t *>(indices.cpu)[r * 6 + k] = uint16_t(tri[k]);
+    }
+  }
+  g.indexed = true;
+  g.index_count = rects * 6;
+  g.index_view = plume::RenderIndexBufferView(indices.ref, index_bytes,
+                                              wide ? plume::RenderFormat::R32_UINT : plume::RenderFormat::R16_UINT);
+  if (!g_bound.zero_stream) {
+    g_bound.zero_stream = Video::UploadsLocked().Allocate(kZeroStreamSize, 16);
+    if (!g_bound.zero_stream)
+      return false;
+    std::memset(g_bound.zero_stream.cpu, 0, kZeroStreamSize);
+  }
+  const plume::RenderVertexBufferView zero_view(g_bound.zero_stream.ref, kZeroStreamSize);
+  const plume::RenderInputSlot zero_slot(kZeroStreamSlot, 0);
+  SetVertexBuffer(cmd, zero_view, zero_slot);
+  return true;
+}
