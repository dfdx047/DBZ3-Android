+// The rectangle's corner at the right angle (0-2) from its positions, as rectangle_list_gs finds it; 0 when the
+// position is not 32-bit float.
+u32 RightAngleCorner(const HostVertexElement *position, const u8 *const v[3]) {
+  if (!position || (position->host_format != plume::RenderFormat::R32G32_FLOAT &&
+                    position->host_format != plume::RenderFormat::R32G32B32_FLOAT &&
+                    position->host_format != plume::RenderFormat::R32G32B32A32_FLOAT))
+    return 0;
+  float p[3][2];
+  for (u32 i = 0; i < 3; ++i)
+    std::memcpy(p[i], v[i] + position->host_offset, 8);
+  auto skew = [&](u32 i, u32 j, u32 k) {
+    return std::abs((p[j][0] - p[i][0]) * (p[k][0] - p[i][0]) + (p[j][1] - p[i][1]) * (p[k][1] - p[i][1]));
+  };
+  const float s0 = skew(0, 1, 2), s1 = skew(1, 2, 0), s2 = skew(2, 0, 1);
+  if (s1 < s0 && s1 <= s2)
+    return 1;
+  if (s2 < s0 && s2 < s1)
+    return 2;
+  return 0;
+}
