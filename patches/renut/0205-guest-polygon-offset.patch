   key.stencil_ref_mask = t.depth ? u32(dev.m_ValuesPacket.StencilRefMask) & 0xFFFFFF : 0;
   key.stencil_ref_mask_bf = t.depth ? u32(dev.m_ValuesPacket.StencilRefMaskBF) & 0xFFFFFF : 0;
   key.mode_control = u32(cp.ModeControl) & 0x7;
+  // Dragon Fury (2026-10-30): the guest's polygon offset, as Xenia's host render target path takes it
+  // (GetPreferredFacePolygonOffset): PA_SU_SC_MODE_CNTL poly_offset_front_enable (bit 11) unless front faces are
+  // culled, else poly_offset_back_enable (bit 12); poly_offset_para_enable (bit 13) for points and lines. The values are
+  // the device's copies of PA_SU_POLY_OFFSET_FRONT/BACK_SCALE/OFFSET at 0x2A50 (D3DRS_SLOPESCALEDEPTHBIAS * 16,
+  // D3DRS_DEPTHBIAS). The constant is in units of 24-bit depth (2^24 - 1 a unit, Xenia's
+  // kD3D10PolygonOffsetFactorUnorm24, also for its float24 emulated as float32); the slope in 1/16 pixel, times the
+  // resolution scale when that is above 1 (more bias rather than less). The Budokai 1 shadow pass lays its depth with
+  // it: without it the lit side of every model failed its own shadow test, a triangle at a time (Raditz's face).
+  if (t.depth) {
+    const u32 mode = u32(cp.ModeControl);
+    const bool polygonal = primitive != kPointList && primitive != kLineList && primitive != kLineStrip &&
+                           primitive != kLineLoop;
+    float scale = 0.0f, offset = 0.0f;
+    if (polygonal) {
+      if ((mode & (1u << 11)) && !(mode & 1u)) {
+        scale = device.F32(0x2A50);
+        offset = device.F32(0x2A54);
+      }
+      if ((mode & (1u << 12)) && !(mode & 2u) && scale == 0.0f && offset == 0.0f) {
+        scale = device.F32(0x2A58);
+        offset = device.F32(0x2A5C);
+      }
+    } else if (mode & (1u << 13)) {
+      scale = device.F32(0x2A50);
+      offset = device.F32(0x2A54);
+    }
+    if (std::isfinite(scale) && std::isfinite(offset) && (scale != 0.0f || offset != 0.0f)) {
+      const float units = offset * float((1u << 24) - 1);
+      key.depth_bias = int32_t(std::clamp(units < 0.0f ? std::floor(units) : std::ceil(units), -1.0e9f, 1.0e9f));
+      key.depth_bias_slope = scale * (1.0f / 16.0f) * std::max(1.0f, t.scale.Factor());
+    }
+  }
   const u32 raster_override = REXCVAR_GET(mgr_renut_diag_raster_override);
   if (raster_override & 1) key.depth_control &= ~6u;
   if (raster_override & 2) key.mode_control &= ~3u;
