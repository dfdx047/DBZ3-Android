+
+// DBZ3-Android (0077): the guest vblank rate (the video mode's refresh rate), for renderers without the Xenia GPU's
+// vblank timer (the Renut paces its frames by it).
+namespace rex::graphics {
+double GetGuestVblankRate() {
+  system::X_VIDEO_MODE video_mode;
+  kernel::xboxkrnl::VdQueryVideoMode(&video_mode);
+  return std::max(1.0, double(float(video_mode.refresh_rate)));
+}
