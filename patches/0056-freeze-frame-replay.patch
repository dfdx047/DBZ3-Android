+void CommandProcessor::Dbz3FreezeReplay() {
+  namespace fz = dbz3_freeze;
+  // ~60 vezes por segundo, como o jogo.
+  const auto now = std::chrono::steady_clock::now();
+  if (now < fz::g_next_replay) {
+    rex::thread::Sleep(std::chrono::duration_cast<std::chrono::milliseconds>(
+                           fz::g_next_replay - now) +
+                       std::chrono::milliseconds(1));
+    return;
+  }
+  fz::g_next_replay = std::max(fz::g_next_replay + std::chrono::microseconds(16667),
+                               now - std::chrono::milliseconds(50));
+  Dbz3FreezeWriteRegisters(fz::g_start_regs);
+  fz::g_replaying = true;
+  if (!fz::g_ring_copy.empty()) {
+    memory::RingBuffer reader(fz::g_ring_copy.data(), fz::g_ring_copy.size());
+    reader.set_write_offset(fz::g_ring_copy.size());
+    do {
+      if (!ExecutePacket(&reader)) {
+        break;
+      }
+    } while (reader.read_count());
+  }
+  fz::g_replaying = false;
+  OnPrimaryBufferEnd();
+  ++fz::g_replays;
+}
