+void CommandProcessor::Dbz3FreezeWriteRegisters(const std::vector<uint32_t>& values) {
+  if (values.size() != RegisterFile::kRegisterCount) {
+    return;
+  }
+  RegisterFile& regs = *register_file_;
+  for (uint32_t i = 0; i < RegisterFile::kRegisterCount; ++i) {
+    // Sem os registos com efeitos fora da GPU (escrita na memoria, LUT da gama, coerencia).
+    if ((i >= XE_GPU_REG_SCRATCH_REG0 && i <= XE_GPU_REG_SCRATCH_REG7) ||
+        i == XE_GPU_REG_SCRATCH_ADDR || i == XE_GPU_REG_SCRATCH_UMSK ||
+        i == XE_GPU_REG_COHER_STATUS_HOST || i == XE_GPU_REG_DC_LUT_RW_INDEX ||
+        i == XE_GPU_REG_DC_LUT_SEQ_COLOR || i == XE_GPU_REG_DC_LUT_PWL_DATA ||
+        i == XE_GPU_REG_DC_LUT_30_COLOR) {
+      continue;
+    }
+    if (regs.values[i] != values[i]) {
+      WriteRegister(i, values[i]);
+    }
+  }
+}
